  "cards": [
    {
      "dot": "amber",
      "title": "Pause behavior",
      "items": [
        "In human mode patient messages are stored and mirrored but never forwarded to the agent",
        "Each staff message in WhatsApp resets the 1 hour clock; a handoff nobody answered waits indefinitely",
        "Chatwoot resolve or the agente label returns to agent mode without a welcome-menu restart",
        "handoff node, a Chatwoot staff reply or the administracion label put the conversation in human mode"
      ]
    },
    {
      "dot": "cyan",
      "title": "Fresh restart",
      "items": [
        "/bot and the 1h timeout rotate the workflow session and render the welcome menu on the next turn",
        "Messages and contact memory are kept"
      ]
    }
