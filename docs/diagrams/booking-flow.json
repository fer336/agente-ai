  "cards": [
    {
      "dot": "rose",
      "title": "Confirmation gates",
      "items": [
        "Typed name and DNI are echoed with Confirmar / Modificar before any Dentalink lookup",
        "The proposed slot is a PendingAction: only Confirmar / Cancelar buttons can settle it, free text cannot",
        "The slot is revalidated against Dentalink right before the write"
      ]
    },
    {
      "dot": "amber",
      "title": "Branches",
      "items": [
        "A remembered patient skips identification",
        "Not found offers register, retry, or an advisor; repeated misses hand off to a human",
        "If the patient is still unknown after picking a slot, identification runs then"
      ]
    }
  ]
