  "cards": [
    { "dot": "amber", "title": "Real or fake", "items": [
      "Each adapter is real only when its setting is non-empty; otherwise an in-memory fake is injected",
      "Switches: YCLOUD_API_KEY, DENTALINK_ACCESS_TOKEN, LLM_API_URL, CHATWOOT_API_ACCESS_TOKEN, TELEGRAM_BOT_TOKEN"
    ] },
    { "dot": "rose", "title": "Fake or not wired", "items": [
      "YCloud media gateway, media downloader and the Linear incident gateway are always fakes",
      "Groq transcription is wired in DI, but its audio worker is not scheduled: audio is not processed end to end"
    ] },
    { "dot": "cyan", "title": "Runtime", "items": [
      "One process: the follow-up worker always runs, the reminder worker only when enabled",
      "PostgreSQL and Redis are always real"
    ] }
